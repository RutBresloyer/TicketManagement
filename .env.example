# Copy to .env (gitignored) and replace the placeholders with your own strong values.
# SQL Server policy: at least 8 characters with 3 of: upper case, lower case, digits, symbols.
# Avoid ';' '=' quotes and spaces (the values are embedded in connection strings).
# Generate e.g. with:  printf 'Rm1_%s\n' "$(openssl rand -hex 16)"

# SA password of the local SQL Server container (admin: migrations, seeding, tests only).
MSSQL_SA_PASSWORD=<generate-a-strong-password>

# Password of the least-privilege runtime login 'rm_app' used by the API.
RM_APP_PASSWORD=<generate-another-strong-password>

# Host port for SQL Server (bound to 127.0.0.1 only).
SQLSERVER_PORT=14333
